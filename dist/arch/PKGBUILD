# Arch Linux package for To The Roots, built from the git repository.
#
#   cd dist/arch && makepkg -si
#
# installs /usr/bin/ttr, /usr/bin/ttr-session and
# /usr/share/xsessions/ttr.desktop, so display managers (SDDM, LightDM,
# GDM, ...) offer "To The Roots" as a session.

pkgname=ttr-git
pkgver=r0
pkgrel=1
pkgdesc="To The Roots: mwm-style window manager with a Windows 2000-style taskbar"
arch=('x86_64' 'aarch64')
url="https://github.com/techomancer/ttr"
license=('BSD-3-Clause')
# ttr draws with X core fonts: the bitmap fonts have Helvetica in every
# size the UI scale needs, and mkfontscale indexes font folders (fonts.dir)
# as font packages are installed, so the X server can use them.
depends=('openmotif' 'libxt' 'libxpm' 'libpng' 'dbus' 'libx11'
         'xorg-fonts-75dpi' 'xorg-fonts-100dpi' 'xorg-fonts-misc'
         'xorg-mkfontscale')
makedepends=('git')
optdepends=('xorg-server-xephyr: tools/nested.sh, to try ttr in a window'
            'wireplumber: volume control with PipeWire (wpctl)'
            'libpulse: volume control with PulseAudio (pactl)'
            'alsa-utils: volume control with ALSA (amixer)'
            'pavucontrol: sound panel from the volume menu'
            'udisks2: mount removable drives without root (udisksctl)'
            'xterm: the default terminal'
            'gsfonts: scalable Type1 fonts, Nimbus Sans is like Helvetica'
            'ttf-dejavu: scalable TrueType fonts'
            'ttf-liberation: scalable TrueType fonts'
            'xorg-xlsfonts: list the fonts the X server has')
provides=('ttr')
conflicts=('ttr')
source=('ttr::git+https://github.com/techomancer/ttr.git'
        'nanosvg::git+https://github.com/memononen/nanosvg.git')
sha256sums=('SKIP' 'SKIP')

pkgver() {
    cd ttr
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd ttr
    git submodule init
    git config submodule.third_party/nanosvg.url "$srcdir/nanosvg"
    git -c protocol.file.allow=always submodule update
}

build() {
    cd ttr
    make DBUS_CFLAGS="$(pkg-config --cflags dbus-1)"
}

package() {
    cd ttr
    make DESTDIR="$pkgdir" PREFIX=/usr install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
